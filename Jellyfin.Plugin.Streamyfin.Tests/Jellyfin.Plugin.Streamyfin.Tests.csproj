<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
        <PackageReference Include="xunit" Version="2.8.1" />
        <PackageReference Include="xunit.runner.console" Version="2.8.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Embedded rather than copied to the output directory: the parity test then
             reads it through the assembly and does not depend on which directory
             dotnet test was invoked from. -->
        <EmbeddedResource Include="../Jellyfin.Plugin.Streamyfin/AppSettingsManifest.json" LogicalName="AppSettingsManifest.json" />
        <!-- The examples the repository ships, checked against the Yaml editor's schema. -->
        <EmbeddedResource Include="../examples/*" LogicalName="examples/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jellyfin.Plugin.Streamyfin\Jellyfin.Plugin.Streamyfin.csproj" />
    </ItemGroup>
</Project>
