        <value>Inicio de sesión fallido</value>
    </data>
    <data name="SignInFailed" xml:space="preserve">
        <!-- 0 = Username that was tried -->
        <value>{0} no pudo iniciar sesión</value>
    </data>
    <data name="SignInFailedFrom" xml:space="preserve">
        <!-- 0 = Username that was tried, 1 = Address it came from -->
        <value>{0} no pudo iniciar sesión desde {1}</value>
