    <data name="SeerrUnknownMedia" xml:space="preserve">
        <value>Média inconnu</value>
    </data>
    <data name="SeerrUnknownRequester" xml:space="preserve">
        <value>Quelqu'un</value>
    </data>
    <data name="SeerrTestTitle" xml:space="preserve">
        <value>Seerr est connecté</value>
